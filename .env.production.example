# ============================================================================
# comGpt — PRODUCTION environment template
# Copy to .env, replace every CHANGE_ME, then protect it:
#   chmod 600 .env        (Windows: restrict the file ACL to your service account)
# NEVER commit the real .env.
#
# Bring up with:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#   (or scripts/prod-up.sh / scripts/prod-up.ps1)
# ============================================================================

# ---- Public host / TLS (Caddy auto-provisions and renews Let's Encrypt certs) ----
# DOMAIN must resolve to this server's public IP; ports 80 and 443 must be open.
# No owned domain? Use a free nip.io hostname, e.g. DOMAIN=comgpt.<your-ip>.nip.io
# (auto-resolves to your IP; Let's Encrypt issues for it). scripts/oracle-bootstrap.sh
# sets this up for you on Oracle Cloud Free ARM. A single DOMAIN serves both the UI
# and the API: Caddy routes /api/v1/* (incl. the WhatsApp webhook) to the backend.
DOMAIN=app.example.com
ACME_EMAIL=you@example.com
FRONTEND_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=comGpt

# ---- PostgreSQL (internal-only; no host port published in production) ----
POSTGRES_DB=omniflow
POSTGRES_USER=omniflow
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# compose wires DATABASE_URL/USERNAME/PASSWORD from these automatically.

# ---- RabbitMQ (internal-only) ----
RABBITMQ_USERNAME=omniflow
RABBITMQ_PASSWORD=CHANGE_ME_strong_rabbit_password

# ---- Security ----
# Generate each with: openssl rand -base64 48
OMNIFLOW_JWT_SECRET=CHANGE_ME_at_least_32_random_bytes
# SHA-256 of this value is the AES-256 key that encrypts stored provider credentials.
# SET ONCE, KEEP STABLE, BACK IT UP. Changing it after integrations exist makes them
# undecryptable (every workspace would need its credentials re-entered).
OMNIFLOW_ENCRYPTION_KEY=CHANGE_ME_random_encryption_key

# ---- Demo data (optional seeded workspace for instant login) ----
# true seeds a demo owner + sample contacts/campaigns/templates on first boot.
# Idempotent: only seeds if OMNIFLOW_DEMO_EMAIL doesn't already exist.
# SECURITY: this is a public app — set false before onboarding real clients, or
# use a strong OMNIFLOW_DEMO_PASSWORD. scripts/oracle-bootstrap.sh enables this
# with a random password and prints the login at the end.
OMNIFLOW_DEMO_DATA=false
OMNIFLOW_DEMO_EMAIL=owner@omniflow.local
OMNIFLOW_DEMO_PASSWORD=CHANGE_ME_demo_password
OMNIFLOW_DEMO_ORG=Acme Retail

# ---- Shared email secret: ONE SMTP relay for ALL workspaces ----
# Relay-agnostic: point this at your own open-source mail server, Amazon SES,
# Mailgun, Postmark, etc. Each workspace's EMAIL integration leaves credentials
# BLANK and sets only its own fromAddress + fromName; the send path inherits these.
# Verify each client's from-address/domain in the relay (e.g. SES verified identities).
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_smtp_username
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_STARTTLS=true
SMTP_FROM=noreply@app.example.com

# ---- Shared WhatsApp secret: ONE Meta app / WABA for ALL workspaces ----
# Each workspace's WHATSAPP integration sets only its own config.phoneNumberId
# (and config.templateName for approved marketing templates); blank credentials
# inherit this token. Register each client's number + brand display name in Meta.
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_meta_system_user_token
WHATSAPP_APP_SECRET=CHANGE_ME_meta_app_secret
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_random_verify_token
# Leave blank so each workspace's config.phoneNumberId wins (do not set a global number).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Rate limits (per organization, per minute) ----
OMNIFLOW_RATE_EMAIL_PER_MIN=600
OMNIFLOW_RATE_WHATSAPP_PER_MIN=300
OMNIFLOW_RATE_SMS_PER_MIN=300

# ---- Bulk contact imports (shared staging volume; Caddy has no small body cap) ----
IMPORT_STAGING_DIR=/app/data/imports
IMPORT_MAX_CHUNK_MB=64
IMPORT_MAX_FILE_BYTES=0

# ---- Observability (optional: add --profile observability) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password