# ============================================================================
# comGpt — COOLIFY environment reference
# ----------------------------------------------------------------------------
# This is a checklist of what to paste into Coolify's Environment Variables UI
# for the docker-compose.coolify.yml deployment. Do NOT commit a filled-in copy.
# Coolify reads the ${VAR} references in the compose file and stores values in its
# own secret store; there is no .env file on the server to protect.
#
# No DOMAIN / ACME_EMAIL here: Coolify's Traefik proxy issues and renews the
# Let's Encrypt certificates. You assign domains in the Coolify UI instead:
#   frontend    -> https://app.yourdomain.com:3000
#   backend-api -> https://api.yourdomain.com:8080   (provider webhooks only)
# ============================================================================

# ---- REQUIRED (compose fails fast if any of these is empty) ----
# Public origin of the frontend, must match the domain you assign in Coolify.
FRONTEND_URL=https://app.yourdomain.com
# Generate each secret with:  openssl rand -base64 48   (or -hex 24 for passwords)
POSTGRES_PASSWORD=123456789
RABBITMQ_PASSWORD=123456789
OMNIFLOW_JWT_SECRET=123456789
# SET ONCE, KEEP STABLE, BACK IT UP. SHA-256 of this is the AES-256 key for stored
# provider credentials. Changing it later makes existing integrations undecryptable.
OMNIFLOW_ENCRYPTION_KEY=123456789

# ---- Optional identity / branding ----
POSTGRES_DB=omniflow
POSTGRES_USER=omniflow
RABBITMQ_USERNAME=omniflow
NEXT_PUBLIC_APP_NAME=comGpt

# ---- Shared email relay: ONE SMTP for ALL workspaces (set to enable delivery) ----
# Relay-agnostic: your own open-source mail server, Amazon SES, Mailgun, Postmark,
# Brevo, etc. Each workspace's EMAIL integration leaves credentials BLANK and sets
# only its own fromAddress + fromName; the send path inherits these values.
# Verify each client's from-address/domain in the relay (e.g. SES verified identities).
# Until SMTP_HOST is set, email sends fail (there is no Mailpit catcher on Coolify).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=Aravind
SMTP_PASSWORD=123456789
SMTP_STARTTLS=true
SMTP_FROM=noreply@app.yourdomain.com

# ---- Shared WhatsApp: ONE Meta app / WABA for ALL workspaces (set to enable) ----
# Each workspace's WHATSAPP integration sets only its own config.phoneNumberId
# (and config.templateName for approved marketing templates); blank credentials
# inherit this token. Register each client's number + brand display name in Meta.
# WHATSAPP_APP_SECRET validates inbound webhook signatures; WHATSAPP_VERIFY_TOKEN
# is the hub.verify_token you enter in the Meta webhook setup. Leave PHONE_NUMBER_ID
# blank so each workspace's config.phoneNumberId wins.
WHATSAPP_ACCESS_TOKEN=EAAXZAF7uECZAQBS75H69oI9EZAyR1cq0Y94MZAWzTxTiFmxPVXBTqhsqMQ9gSsDwtXYA0wBgaZAiOEPRozUD1o7jol2ds2M2zK2969MhwerUCRf6ZAhUCEgKOZBZBaxgyAWhClZBx9lqmYiO1bOCyepJu1AZB1d82FuJ4QYmpU0rqXijsDIXIwgwxlz60FDUWyHwZDZ
WHATSAPP_APP_SECRET=5f48b30e0dd28ed029ad0b42209f762d
WHATSAPP_VERIFY_TOKEN=sushmasushmasushma
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- Rate limits (per organization, per minute) ----
OMNIFLOW_RATE_EMAIL_PER_MIN=600
OMNIFLOW_RATE_WHATSAPP_PER_MIN=300
OMNIFLOW_RATE_SMS_PER_MIN=300

# ---- Bulk contact imports (shared staging volume) ----
IMPORT_STAGING_DIR=/app/data/imports
IMPORT_MAX_CHUNK_MB=64
IMPORT_MAX_FILE_BYTES=0
IMPORT_LOCK_SECONDS=3600
IMPORT_MAX_ATTEMPTS=5