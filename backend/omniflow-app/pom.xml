<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.omniflow</groupId>
        <artifactId>omniflow-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>omniflow-app</artifactId>
    <name>comGpt :: REST API application</name>

    <dependencies>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-identity</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-organization</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-crm</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-segmentation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-consent</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-template</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-campaign</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-email</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-whatsapp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-sms</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-automation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-inbox</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-analytics</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-integration</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-billing</artifactId>
        </dependency>
        <dependency>
            <groupId>com.omniflow</groupId>
            <artifactId>omniflow-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../../database/migrations</directory>
                <targetPath>db/migration</targetPath>
            </resource>
        </resources>
        <finalName>omniflow-api</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.omniflow.app.OmniFlowApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
