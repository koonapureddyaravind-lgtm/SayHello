<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.omniflow</groupId>
    <artifactId>omniflow-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>comGpt :: Backend</name>
    <description>Omnichannel marketing automation platform</description>

    <modules>
        <module>omniflow-common</module>
        <module>omniflow-identity</module>
        <module>omniflow-organization</module>
        <module>omniflow-crm</module>
        <module>omniflow-segmentation</module>
        <module>omniflow-consent</module>
        <module>omniflow-template</module>
        <module>omniflow-campaign</module>
        <module>omniflow-messaging</module>
        <module>omniflow-email</module>
        <module>omniflow-whatsapp</module>
        <module>omniflow-sms</module>
        <module>omniflow-automation</module>
        <module>omniflow-inbox</module>
        <module>omniflow-analytics</module>
        <module>omniflow-integration</module>
        <module>omniflow-billing</module>
        <module>omniflow-audit</module>
        <module>omniflow-app</module>
        <module>omniflow-worker</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <jjwt.version>0.12.6</jjwt.version>
        <commons-csv.version>1.12.0</commons-csv.version>
        <springdoc.version>2.8.9</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-identity</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-organization</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-crm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-segmentation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-consent</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-template</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-campaign</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-email</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-whatsapp</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-sms</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-automation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-inbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-analytics</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-integration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-billing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.omniflow</groupId>
                <artifactId>omniflow-audit</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-csv</artifactId>
                <version>${commons-csv.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
