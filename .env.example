# ============================================================================
# comGpt — environment template
# Copy to .env and adjust. NEVER commit the real .env.
# ============================================================================

# ---- Runtime ----
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=comGpt

# ---- PostgreSQL ----
POSTGRES_DB=omniflow
POSTGRES_USER=omniflow
POSTGRES_PASSWORD=omniflow_dev_password
POSTGRES_PORT=5432
# Inside docker-compose the host is "postgres". For a local IDE run use localhost.
DATABASE_URL=jdbc:postgresql://postgres:5432/omniflow
DATABASE_USERNAME=omniflow
DATABASE_PASSWORD=omniflow_dev_password

# ---- Redis / Valkey ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- RabbitMQ ----
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=omniflow
RABBITMQ_PASSWORD=omniflow_dev_password
RABBITMQ_MANAGEMENT_PORT=15672

# ---- Security ----
# HS256 secret. Use at least 32 random bytes in production (e.g. `openssl rand -base64 48`).
OMNIFLOW_JWT_SECRET=dev-only-change-me-omniflow-jwt-secret-at-least-32-bytes
OMNIFLOW_JWT_ACCESS_TTL=PT8H
OMNIFLOW_JWT_REFRESH_TTL=P30D
# Used to encrypt provider credentials at rest. SHA-256 of this value is the AES-256 key.
OMNIFLOW_ENCRYPTION_KEY=dev-only-change-me-omniflow-encryption-key

# ---- Email (Mailpit locally; Amazon SES / any SMTP in production) ----
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@omniflow.local
SMTP_STARTTLS=false

# ---- WhatsApp Cloud API ----
WHATSAPP_VERIFY_TOKEN=omniflow-dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ---- SMS ----
# SMS gateway credentials (URL, API key, sender id) are stored per organization
# through Integrations → Add integration and encrypted at rest, so no SMS env vars
# are required here. Per-channel send rate limits live below.

# ---- Rate limits (per organization, per minute) ----
OMNIFLOW_RATE_EMAIL_PER_MIN=600
OMNIFLOW_RATE_WHATSAPP_PER_MIN=300
OMNIFLOW_RATE_SMS_PER_MIN=300

# ---- Bulk contact imports ----
# Staged chunks live on this shared path inside the API and worker containers.
IMPORT_STAGING_DIR=/app/data/imports
# Maximum size of a single uploaded chunk (the browser sends 8 MB by default).
IMPORT_MAX_CHUNK_MB=64
# 0 = unlimited. Set a byte cap in production if you need one.
IMPORT_MAX_FILE_BYTES=0
IMPORT_LOCK_SECONDS=3600
IMPORT_MAX_ATTEMPTS=5

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Demo data ----
# Seeds a demo owner, organization and contacts on first start.
OMNIFLOW_DEMO_DATA=true
OMNIFLOW_DEMO_EMAIL=owner@omniflow.local
OMNIFLOW_DEMO_PASSWORD=OmniFlow123!
OMNIFLOW_DEMO_ORG=Acme Retail
