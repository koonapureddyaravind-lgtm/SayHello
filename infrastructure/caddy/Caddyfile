# comGpt production reverse proxy — automatic HTTPS via Let's Encrypt.
# Set DOMAIN to your public hostname (and ACME_EMAIL for certificate notices).
# Meta requires HTTPS webhook callbacks; Caddy provisions and renews certs automatically.
{
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN:localhost} {
	encode zstd gzip

	# Spring Boot REST API + provider webhooks. Webhooks are public; the rest is JWT-protected.
	@api path /api/v1/*
	handle @api {
		reverse_proxy backend-api:8080
	}

	# Next.js frontend, including its same-origin /api/backend/* proxy and /api/org|auth routes.
	handle {
		reverse_proxy frontend:3000
	}
}
